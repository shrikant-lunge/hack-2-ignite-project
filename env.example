# ─── EcoStride Environment Configuration ─────────────────
# Copy this file to .env and fill in your values
# cp env.example .env

# ─── API Keys ────────────────────────────────
OPENWEATHER_API_KEY=your_openweather_api_key
AQICN_API_TOKEN=your_aqicn_api_token

# ─── LLM Configuration ──────────────────────
GROQ_API_KEY=your_groq_api_key
GEMINI_API_KEY=your_gemini_api_key
USE_LOCAL_LLM=false

# ─── AirGuard Agent (Claude) ────────────────
# Get your free key at: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key

# ─── Government Data (Data.gov.in) ──────────
GOV_INDIA_API_KEY=your_gov_india_api_key
GOV_INDIA_RESOURCE_ID=3b01bcb8-0b14-4abf-b6f2-c1bfd384ba69

# ─── Firebase Configuration ─────────────────
# Get your Firebase Database URL from Firebase Console > Realtime Database
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
# Place your Firebase service account JSON in the Keys/ directory
# as Keys/eco-stride2026.json (or set FIREBASE_CREDENTIALS env var)

# ─── Frontend Firebase Config ───────────────
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com

# ─── Email / SMS Alerts (Optional) ──────────
# SMTP_EMAIL=your_email@gmail.com
# SMTP_APP_PASSWORD=your_app_password
# AUTHORITY_EMAIL=authority@example.com
# FAST2SMS_API_KEY=your_fast2sms_key

# ─── Database ────────────────────────────────
DATABASE_PATH=database/teamx.db

# ─── Server ──────────────────────────────────
HOST=127.0.0.1
PORT=5000
DEBUG=true

# ─── Caching & Updates ──────────────────────
CACHE_ENABLED=true
CACHE_DURATION=900
DATA_UPDATE_INTERVAL=15
FORECAST_RETRAIN_DAYS=7
